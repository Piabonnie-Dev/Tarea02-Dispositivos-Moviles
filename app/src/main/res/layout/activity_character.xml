<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainCharacter"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FICHA DEL PERSONAJE"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00A7C4"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <!-- SALUDO -->

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="5dp" />

        <!-- NOMBRE DEL PERSONAJE -->

        <TextView
            android:id="@+id/tvNombrePersonaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hatsune Miku"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp" />

        <!-- IMAGEN -->

        <ImageView
            android:id="@+id/imgPersonaje"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:contentDescription="Imagen del personaje"
            android:layout_marginBottom="20dp" />

        <!-- TIPO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sintetizador de voz"
            android:textSize="17sp"
            android:textColor="#444444"
            android:layout_marginBottom="18dp" />

        <!-- INFORMACIÓN -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Información:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información del personaje."
            android:textSize="17sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp" />

        <!-- CANCIÓN FAVORITA DEL USUARIO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu canción favorita:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvCancion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin especificar"
            android:textSize="17sp"
            android:textColor="#444444"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp" />

        <!-- REGRESAR -->

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELEGIR OTRO PERSONAJE"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>