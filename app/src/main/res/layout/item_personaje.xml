<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="98dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/fondo_fila">

    <!-- Imagen del personaje -->
    <ImageView
        android:id="@+id/imgListaPersonaje"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/miku"
        android:scaleType='fitCenter'
        android:background="#F1F9FB"
        android:padding="3dp"
        android:contentDescription="Imagen del personaje"/>

    <!-- Informacion del personaje -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvListaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hatsune Miku"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- Tipo de cantante -->
        <TextView
            android:id="@+id/tvListaTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vocaloid"
            android:textSize="14sp"
            android:textColor="#777777"
            android:layout_marginTop="5dp" />

    </LinearLayout>

    <!-- Icono musical -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♫"
        android:textSize="30sp"
        android:textColor="#00A7C4"
        android:padding="6dp"
        android:importantForAccessibility="no" />

</LinearLayout>